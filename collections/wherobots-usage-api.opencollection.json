{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wherobots Cloud apikey usage API",
    "version": "0.0.1"
  },
  "items": [
    {
      "info": {
        "name": "usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get workload usage chart data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/usage/workloads/chart",
            "params": [
              {
                "name": "timerange",
                "value": "",
                "type": "query",
                "description": "The time range for the usage chart."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get workload usage chart data"
        },
        {
          "info": {
            "name": "Get workload usage summary info",
