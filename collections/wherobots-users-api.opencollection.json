{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wherobots Cloud apikey users API",
    "version": "0.0.1"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/users/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get current user profile"
        },
        {
          "info": {
            "name": "Update current user role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.wherobots.com/users/me/role",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update current user role"
        },
        {
          "info": {
            "name": "Verify access to an app path",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/users/me/path-access",
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Verify access to an app path"
        },
        {
          "info": {
            "name": "Get pending organization invitations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/organization/:organization_id/users/invitations",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get pending organization invitations"
        }
      ]
    }
  ],
  "bundled": true
}