{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wherobots Cloud apikey runs API",
    "version": "0.0.1"
  },
  "items": [
    {
      "info": {
        "name": "runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List job runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/runs",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "region",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for the next page"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List job runs"
        },
        {
          "info": {
            "name": "Create a job run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.wherobots.com/runs",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a job run"
        },
        {
          "info": {
            "name": "Get a job run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/runs/:run_id",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a job run"
        },
        {
          "info": {
            "name": "Cancel a job run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.wherobots.com/runs/:run_id/cancel",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Cancel a job run"
        },
        {
          "info": {
            "name": "Get job run logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/runs/:run_id/logs",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get job run logs"
        },
        {
          "info": {
            "name": "Get job run metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/runs/:run_id/metrics",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get job run metrics"
        }
      ]
    }
  ],
  "bundled": true
}