      "items": [
        {
          "info": {
            "name": "Get organization subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/management/organization/:organization_id/subscription",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get organization's active subscription details.\n\nThis endpoint is for superusers only and returns the active subscription\ninformation including type-specific details (AWS Marketplace, Stripe, etc.)."
        },
        {
          "info": {
            "name": "Get organization workload costs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloud.wherobots.com/management/organization/:organization_id/usage/costs",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Orb-calculated workload costs for any organization.\n\nThis endpoint is for superusers only. Unlike the org-scoped\n``POST /usage/costs``, it resolves costs for an arbitrary organization\nidentified by ``organization_id``."
        },
