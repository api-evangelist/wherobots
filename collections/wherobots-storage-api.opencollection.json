        {
          "info": {
            "name": "List storage integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloud.wherobots.com/storage",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List storage integrations"
        },
        {
          "info": {
            "name": "Create a storage integration",
            "type": "http"
          },
          "http": {
