          "name": "Cancel a running Rasterflow workflow run by ID",
          "request": {
            "name": "Cancel a running Rasterflow workflow run by ID",
            "description": {
              "content": "Abort a running Union/Flyte workflow run.\n\nThe run and its Union project/domain are resolved from the local copy of\nthe run. Cancelling an already-terminal run is a no-op.",
              "type": "text/plain"
            },
            "url": {
